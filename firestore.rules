rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── USERS ─────
    // Sobai login thakle nijer o onner profile dekhte parbe (leaderboard, friends list e dorkar)
    // Kintu nijer document chara onno karo data write/delete korte parbe na
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ───── CONVERSATIONS / DM CHAT ─────
    // dmId = [uid1, uid2].sort().join("_")  => documentId-e duijon-er uid thake
    // Tai shudhu oi duijon e nijeder conversation porte/likhte parbe
    match /conversations/{convId} {
      allow read, write: if request.auth != null &&
        convId.split('_')[0] == request.auth.uid ||
        convId.split('_')[1] == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          (convId.split('_')[0] == request.auth.uid ||
           convId.split('_')[1] == request.auth.uid);

        allow create: if request.auth != null &&
          (convId.split('_')[0] == request.auth.uid ||
           convId.split('_')[1] == request.auth.uid) &&
          request.resource.data.senderId == request.auth.uid;

        allow update, delete: if request.auth != null &&
          resource.data.senderId == request.auth.uid;
      }

      // WebRTC call signaling
      match /calls/{callId} {
        allow read, write: if request.auth != null &&
          (convId.split('_')[0] == request.auth.uid ||
           convId.split('_')[1] == request.auth.uid);

        match /callerCandidates/{candId} {
          allow read, write: if request.auth != null &&
            (convId.split('_')[0] == request.auth.uid ||
             convId.split('_')[1] == request.auth.uid);
        }
        match /calleeCandidates/{candId} {
          allow read, write: if request.auth != null &&
            (convId.split('_')[0] == request.auth.uid ||
             convId.split('_')[1] == request.auth.uid);
        }
      }
    }

    // ───── COMMUNITY CHAT (public room) ─────
    // Login thakle sobai porte o nijer naam diye message likhte parbe
    match /community_chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.senderId == request.auth.uid;
    }

    // ───── LISTENING SESSIONS ─────
    // Login thakle nijer session save korte parbe, onner ta porbe na
    match /listening_sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.lessonId is string;
      allow update, delete: if false;
    }

        // ───── CHAT ROOMS (used by chat.html) ─────
    match /chat_rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if request.auth != null &&
          resource.data.uid == request.auth.uid;
      }
    }

    // ───── QUIZ SCORES (root collection — used by progress.html history/chart) ─────
    // Nijer score read korte parbe, create korte parbe, kintu change/delete kora jabe na
    match /scores/{scoreId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ───── WRITING LAB ─────
    // writings: submitted writing pieces (sentence/paragraph/essay/email/story)
    // User nijer submission create korte parbe, nijer ta porte/dekhte parbe
    match /writings/{writingId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.type is string &&
        request.resource.data.content is string;
      allow update, delete: if false;
    }

    // writing_drafts: auto-saved drafts, doc id = {uid}_{type}_{taskId}
    // Nijer draft read/write/update korte parbe
    match /writing_drafts/{draftId} {
      allow read, write: if request.auth != null &&
        draftId.matches(request.auth.uid + '_.*');
    }

    // ───── LEADERBOARD ─────
    // Shudhu read-only. Score update hobe users/{uid} document e (xp, totalCorrect etc.)
    // tai alada leaderboard collection lagle eta shudhu read kora hobe.
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow write: if false; // server-side (Cloud Function) theke update hobe
    }

    // ───── CHALLENGES / DAILY TASKS ─────
    // Shob users porte parbe, kintu kichu modify korte parbe na (admin/Cloud Function thik korbe)
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User-specific challenge progress
    match /users/{userId}/challengeProgress/{progressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User-specific quiz scores (quiz-beginner, quiz-intermediate, quiz-advanced)
    // Shudhu nijer score likhte/porte parbe
    match /users/{userId}/scores/{scoreId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false; // score immutable — ekbar save hoile change hobe na
    }

    // ───── LIVE CLASS ROOMS ─────
    // Jei kono logged-in user room dekhte o join korte parbe
    // Room create korte parbe, kintu delete korbe shudhu host (uid match)
    match /liveRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null; // participant count, waitingCount update dorkar
      allow delete: if request.auth != null &&
        resource.data.hostUid == request.auth.uid;

      // Participants — jara room-e ache
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Waiting room — join request queue
      match /waiting/{uid} {
        allow read: if request.auth != null; // host sob dekhbe
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || resource.data.uid == request.auth.uid);
      }

      // WebRTC signaling — peer-to-peer offer/answer/ICE
      match /signals/{signalId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.from == request.auth.uid;
        allow delete: if request.auth != null;
        allow update: if false;
      }
    }

    // ───── FRIEND REQUESTS ─────
    // Jei kono logged-in user nijer request dekhte, pathate, update/delete korte parbe
    match /friendRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.status == "pending";
      allow update: if request.auth != null &&
        resource.data.to == request.auth.uid &&  // শুধু receiver accept করতে পারবে
        request.resource.data.status == "accepted";
      allow delete: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ───── DEFAULT: sob kichu deny ─────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
